# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Services
# Python API server for database access (runs on port 3001)
WHATSAPP_API_SERVER_URL=http://localhost:3001

# Go WhatsApp bridge for messaging (runs on port 8080)
WHATSAPP_BRIDGE_URL=http://localhost:8080

# Anthropic API
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Application URL
# Used for internal API calls
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Secret (for securing cron endpoints in production)
CRON_SECRET=random-secret-string
